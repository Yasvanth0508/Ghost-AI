# ==============================================================================
# GHOST AI - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development or set these variables
# directly in your Vercel Project Settings > Environment Variables for production.

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL / Prisma / Neon / Supabase)
# ------------------------------------------------------------------------------
# Pooled PostgreSQL connection string. Supports Prisma Postgres, Neon, or Supabase.
DATABASE_URL="postgres://username:password@your-host:5432/dbname?sslmode=require"

# ------------------------------------------------------------------------------
# 2. CLERK AUTHENTICATION (https://clerk.com)
# ------------------------------------------------------------------------------
# Public Publishable Key & Secret Key from Clerk Dashboard > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk Route Handlers & Redirection Paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ------------------------------------------------------------------------------
# 3. LIVEBLOCKS REALTIME COLLABORATION (https://liveblocks.io)
# ------------------------------------------------------------------------------
# Public & Secret Keys from Liveblocks Dashboard > API Keys
LIVEBLOCKS_PUBLIC_KEY=pk_live_...
LIVEBLOCKS_SECRET_KEY=sk_live_...

# ------------------------------------------------------------------------------
# 4. VERCEL BLOB STORAGE (https://vercel.com/dashboard/stores)
# ------------------------------------------------------------------------------
# Read-Write Token from Vercel Blob Store Settings
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (https://aistudio.google.com)
# ------------------------------------------------------------------------------
# API Key from Google AI Studio
GEMINI_API_KEY=AIzaSy...

# Gemini Model identifier (e.g. gemini-2.5-flash, gemini-2.0-flash, or gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 6. TRIGGER.DEV BACKGROUND JOBS (https://trigger.dev) [Optional / Recommended]
# ------------------------------------------------------------------------------
# Secret Key from Trigger.dev Project Settings > API Keys
TRIGGER_SECRET_KEY=tr_prod_...
